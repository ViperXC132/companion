<Window x:Class="DevAI.App.OrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dev AI Orb"
        Width="76" Height="76"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Orb_MouseLeftButtonDown"
        MouseRightButtonUp="Orb_MouseRightButtonUp"
        Loaded="OrbWindow_Loaded">
    <Window.Resources>
        <Storyboard x:Key="IdlePulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="OrbRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.78" To="1.0" Duration="0:0:2.4" />
            <DoubleAnimation Storyboard.TargetName="OrbRing"
                             Storyboard.TargetProperty="StrokeThickness"
                             From="2.0" To="2.35" Duration="0:0:2.4" />
        </Storyboard>
    </Window.Resources>
    <Grid Background="Transparent" ToolTip="Dev AI Orb — click to open, right-click for options">
        <Ellipse x:Name="OrbRing"
                 Width="48" Height="48"
                 Stroke="#F4F5F7" StrokeThickness="2.1"
                 Fill="Transparent"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Effect>
                <DropShadowEffect Color="#FFFFFF" BlurRadius="7" ShadowDepth="0" Opacity="0.10" />
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="3.5" Height="3.5" Fill="#F4F5F7"
                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                 IsHitTestVisible="False" />
    </Grid>
</Window>
