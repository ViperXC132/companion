<Window x:Class="DevAI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dev AI Orb" Width="980" Height="720" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource OrbBackground}" Foreground="{StaticResource OrbText}"
        FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="DEV AI ORB" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OrbMuted}" />
                <TextBlock Text="Your desktop companion" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="LOCAL AI · LOCAL MEMORY" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource OrbMuted}" HorizontalAlignment="Right" />
                <TextBlock x:Name="StatusText" Text="Ready · Connects to local Ollama"
                           FontSize="11" Foreground="#BFC6D2" Margin="0,5,0,0" HorizontalAlignment="Right" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource OrbPanel}" CornerRadius="16" Padding="16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="4,0,4,12">
                    <TextBlock Text="CONVERSATION" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource OrbMuted}" />
                    <Button DockPanel.Dock="Right" Content="Clear memory" Click="ClearMemory_Click"
                            Padding="10,4" Background="#252A33" Foreground="#F4F5F7" BorderThickness="0" />
                </DockPanel>
                <ListBox x:Name="ConversationList" Grid.Row="1" ItemsSource="{Binding ConversationLines}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#222630" CornerRadius="10" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="{Binding RoleLabel}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#BFC6D2" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#1A1D24" BorderBrush="#2A2F39" BorderThickness="1"
                CornerRadius="12" Padding="10" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="MessageInput" MinHeight="42" MaxHeight="120" Padding="10"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Center"
                         Background="Transparent" Foreground="#F4F5F7" BorderThickness="0"
                         FontSize="13" KeyDown="MessageInput_KeyDown"
                         ToolTip="Type a message. Enter sends; Shift+Enter adds a line."/>
                <Button Grid.Column="1" Content="Listen" Click="Listen_Click" Margin="8,0,0,0"
                        Padding="14,0" Background="#252A33" Foreground="#F4F5F7" BorderThickness="0"/>
                <Button Grid.Column="2" Content="Send" Click="Send_Click" Margin="8,0,0,0"
                        Padding="18,0" Background="#E7EAF0" Foreground="#17191F" BorderThickness="0" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="2,12,2,0">
            <CheckBox x:Name="SpeakResponsesCheckBox" Content="Speak responses" IsChecked="True"
                      Foreground="{StaticResource OrbMuted}" FontSize="11" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Workspace files…" Click="Workspace_Click"
                    Background="Transparent" Foreground="{StaticResource OrbMuted}" BorderThickness="0"
                    FontSize="11" Padding="8,4"/>
            <TextBlock Text="Ollama must be running locally. The microphone is used only when Listen is pressed."
                       Foreground="{StaticResource OrbMuted}" FontSize="10" VerticalAlignment="Center"
                       Margin="16,0,0,0"/>
        </DockPanel>
    </Grid>
</Window>
