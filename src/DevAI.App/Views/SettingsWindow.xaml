<Window x:Class="DevAI.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dev AI Orb — Settings"
        Width="520" Height="390" MinWidth="480" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="#111318" Foreground="#F4F5F7" FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="PREFERENCES" Foreground="#A3A8B3" FontSize="11" FontWeight="SemiBold" />
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0" />
            <TextBlock Text="A few essentials for the desktop orb." Foreground="#A3A8B3" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,28,0,0">
            <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Keep the orb above other windows"
                      IsChecked="True" FontSize="14" Margin="0,0,0,18"
                      Checked="AlwaysOnTop_Changed" Unchecked="AlwaysOnTop_Changed" />
            <CheckBox x:Name="StartPositionCheckBox" Content="Place the orb near the upper-right corner"
                      IsChecked="True" FontSize="14" Margin="0,0,0,18"
                      Checked="StartPosition_Changed" Unchecked="StartPosition_Changed" />
            <TextBlock Text="Preferences apply to this session only. Saving preferences across restarts will be added with the storage phase."
                       TextWrapping="Wrap" Foreground="#A3A8B3" FontSize="12" LineHeight="19" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Width="100" Height="36" Click="Close_Click"
                    Background="#252A33" Foreground="#F4F5F7" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
