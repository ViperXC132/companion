<Application x:Class="DevAI.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="OrbWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="OrbBackground" Color="#111318" />
        <SolidColorBrush x:Key="OrbPanel" Color="#1A1D24" />
        <SolidColorBrush x:Key="OrbText" Color="#F4F5F7" />
        <SolidColorBrush x:Key="OrbMuted" Color="#A3A8B3" />
        <SolidColorBrush x:Key="OrbAccent" Color="#DCE2EA" />
    </Application.Resources>
</Application>
